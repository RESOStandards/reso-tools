{
  "name": "@reso-standards/reso-certification",
  "version": "0.5.0",
  "description": "RESO certification testing toolkit — Add/Edit (RCP-010), Web API Core, Data Dictionary",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "reso-cert": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@reso-standards/reso-client": "file:../reso-client",
    "@reso-standards/reso-validation": "file:../reso-validation",
    "@reso/reso-certification-etl": "github:RESOStandards/reso-certification-etl",
    "@reso/reso-certification-utils": "git+https://github.com/RESOStandards/reso-certification-utils.git#v3.0.0",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "conf": "^15.1.0",
    "express": "^4.21.0",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.3.4",
    "humanize-duration": "^3.33.2",
    "listr2": "^9.0.5",
    "xlsx": "^0.18.5",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
