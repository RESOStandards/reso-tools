{
  "name": "@reso-standards/reso-certification",
  "version": "0.10.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RESOStandards/reso-tools.git",
    "directory": "reso-certification"
  },
  "description": "RESO certification testing toolkit — Add/Edit (RCP-010), Web API Core, Data Dictionary",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "reso-cert": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/legacy dist/etl && cp -r src/legacy dist/legacy && cp -r src/etl dist/etl",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@reso-standards/reso-client": "^0.2.0",
    "@reso-standards/reso-common": "^0.2.0",
    "@reso-standards/reso-metadata-utils": "^0.1.0",
    "@reso-standards/reso-validation": "^0.1.0",
    "@reso/reso-certification-etl": "https://github.com/RESOStandards/reso-certification-etl/archive/refs/heads/main.tar.gz",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "conf": "^15.1.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.5.10",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.3.4",
    "humanize-duration": "^3.33.2",
    "listr2": "^9.0.5",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
