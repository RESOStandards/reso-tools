.vscode
.DS_Store
node_modules/
# a symlinked node_modules is a file to git, so the directory rule above does not cover it
node_modules
dist/
coverage/
results.*
lefthook-local.yml
PLAN.md
PR.md
*.db
*.db-shm
*.db-wal
.github/pages/dd-output/
.github/pages/dd
.github/pages/pagefind/
compliance-results.zip
.env
.env.*
*.env
.reso-cert/
reso-certification/.venv-dd-lint/
__pycache__/
*.pyc

# RESO certification test artifacts
data-availability*.json
metadata-report*.json
data-dictionary*.json
reso-replication-output/
schema-validation-report.json
# `/out/` is root-anchored; the CLI's --output-dir ./out is run from the package dir, so
# cover that too. Run output carries provider metadata and endpoints — never committed.
/out/
reso-certification/out/
# Running the compliance jobs the way CI does collects each container's reports here, via the
# Collect results step in compliance.yml. Only some of the filenames it writes matched the
# patterns above, so the directory left a half-ignored mess in the tree. These are reference-server
# reports rather than provider data, but they are generated either way.
reso-reference-server/compliance/results/
reso-variations.json
upi-validation-report.json
*.resoscript
# Side-effect copy from SDK initReplicationState when run from repo
# root — the canonical copy under reso-certification/ is still
# tracked. See v0.12 cleanup.
/schema-validation-settings.json

# Sample fixtures are intentional — exempt them from the patterns above
!sample-reports/**

# Local MCP server config (may contain bearer tokens)
.mcp.json

# A filled-in certification config carries a live bearer token. The samples under
# reso-certification/sample-configs/ are tracked, and the README used to say to edit one in place
# and run it, which walks an implementer into committing a credential. The documented path is now
# to copy a sample to this name, which git will not take.
*.local.json

# pack:all output — tarballs for linking into reso-tools-private (never committed)
.packs/

# local cert run logs (provider data — never committed)
# Run logs carry provider endpoints and every query URL, so none of them belong in git. The two narrow
# patterns below were not enough: a verbose Core run saved as `fmls2.log` matched neither and showed up
# untracked (2026-10-03). Ignore the extension outright and keep the specific ones for documentation.
*.log
*-core.log
*.verbose.log
vendor-logs/
