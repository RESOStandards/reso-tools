{
  "private": true,
  "name": "@reso-standards/reso-tools",
  "workspaces": [
    "reso-common",
    "reso-metadata-utils",
    "odata-expression-parser",
    "reso-validation",
    "reso-client",
    "reso-certification",
    "reso-reference-server",
    "reso-mcp-server"
  ],
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "bootstrap": "npm install && npm run build",
    "bootstrap:force": "npm install && npm run build",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "npm run typecheck:common && npm run typecheck:metadata-utils && npm run typecheck:filter-parser && npm run typecheck:validation && npm run typecheck:client && npm run typecheck:server && npm run typecheck:certification && npm run typecheck:mcp",
    "typecheck:common": "cd reso-common && npx tsc --noEmit",
    "typecheck:metadata-utils": "cd reso-metadata-utils && npx tsc --noEmit",
    "typecheck:filter-parser": "cd odata-expression-parser && npx tsc --noEmit",
    "typecheck:validation": "cd reso-validation && npx tsc --noEmit",
    "typecheck:client": "cd reso-client && npx tsc --noEmit",
    "typecheck:server": "cd reso-reference-server && npx tsc --noEmit",
    "typecheck:certification": "cd reso-certification && npx tsc --noEmit",
    "typecheck:mcp": "cd reso-mcp-server && npx tsc --noEmit",
    "test": "npm run test:common && npm run test:metadata-utils && npm run test:validation && npm run test:filter-parser && npm run test:client && npm run test:server && npm run test:certification && npm run test:mcp",
    "test:common": "cd reso-common && npx vitest run",
    "test:metadata-utils": "cd reso-metadata-utils && npx vitest run",
    "test:validation": "cd reso-validation && npx vitest run",
    "test:filter-parser": "cd odata-expression-parser && npx vitest run",
    "test:client": "cd reso-client && npx vitest run",
    "test:server": "cd reso-reference-server && npx vitest run",
    "test:certification": "cd reso-certification && npx vitest run",
    "test:mcp": "cd reso-mcp-server && npx vitest run",
    "update:dd-reference": "node reso-certification/utils/fetch-dd-reference.mjs && npm run test:certification",
    "precommit": "npm run lint && npm run typecheck && npm test",
    "bench": "npm run bench:filter-parser && npm run bench:certification",
    "bench:filter-parser": "cd odata-expression-parser && npx vitest bench",
    "bench:certification": "cd reso-certification && npx vitest bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@vitest/coverage-v8": "^4.1.0"
  }
}
