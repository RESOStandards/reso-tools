{
  "name": "@reso-standards/reso-common",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RESOStandards/reso-tools.git",
    "directory": "reso-common"
  },
  "description": "Universal (browser + Node) RESO metadata model and projections — the shared ResoMetadata shape, pure helpers and the EDMX generator. Zero runtime dependencies, no Node APIs.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reference-metadata/*": "./reference-metadata/*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "reference-metadata"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
